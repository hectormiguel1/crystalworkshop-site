---
import { changelog, stageLabel, href, productNames } from '../lib/data';

interface Props {
  product: string;
}
const { product } = Astro.props;
const entries = changelog.filter((e) => e.product === product);
---

<div class="changelog-list not-content">
  {
    entries.map((e) => (
      <section class="cl-entry" id={`release-${e.id}`}>
        <header>
          <strong class="cl-version">v{e.version}</strong>
          <span class={`pill stage-${e.stage}`}>{stageLabel(e.stage)}</span>
          <time datetime={e.date}>{e.date}</time>
        </header>
        <p class="cl-title">{e.title}</p>
        {e.items.length > 0 && (
          <ul>
            {e.items.map((it) => (
              <li set:html={it} />
            ))}
          </ul>
        )}
        <div class="cl-fixed" data-status-fixed data-product={e.product} data-version={e.version} data-products={JSON.stringify(productNames())} hidden>
          <p class="cl-title">Fixed in this release</p>
          <ul class="st-list" data-list />
        </div>
      </section>
    ))
  }
  <p class="cl-more"><a href={href(`changelog/?product=${product}`)}>Every release in the changelog</a></p>
</div>

<script>
  import '../scripts/status-client';
</script>
