---
import Default from '@astrojs/starlight/components/Head.astro';

// One Open Graph image per section (public/og/*.png, made by the generator).
const id = Astro.locals.starlightRoute.id || '';
const section = id === '' || id === 'index' ? 'home' : id.split('/')[0];
const known = ['home', 'downloads', 'changelog', 'crystalworkshop', 'pulsedepot', 'crux', 'mods', 'legal'];
const og = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}og/${known.includes(section) ? section : 'home'}.png`;
const image = Astro.site ? new URL(og, Astro.site).href : og;
---

<Default />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
