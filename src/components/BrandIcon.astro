---
import crystalworkshop from '../assets/brand/crystalworkshop.png';
import pulsedepot from '../assets/brand/pulsedepot.png';
import crux from '../assets/brand/crux.png';
import crystal from '../assets/brand/crystal.png';
import shard from '../assets/brand/shard.svg';

interface Props {
  name: string;
  size?: number;
  alt?: string;
}
const icons: Record<string, ImageMetadata> = { crystalworkshop, pulsedepot, crux, crystal, shard };
const { name, size = 48, alt = '' } = Astro.props;
const icon = icons[name] ?? shard;
---

<img class:list={['brand-icon', { pixel: name !== 'shard' }]} src={icon.src} width={size} height={size} alt={alt} loading="lazy" decoding="async" />
